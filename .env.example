# Immich Configuration
IMMICH_BASE_URL=https://your-immich-server.com

# Single Library (Legacy)
# IMMICH_API_KEY=your-api-key-with-required-scopes

# Multiple Libraries (New - choose one format)
# Option 1: JSON Array
IMMICH_API_KEYS=["api-key-1", "api-key-2"]

# Option 2: Comma-separated
# IMMICH_API_KEYS=api-key-1,api-key-2

# Option 3: Named Libraries (Advanced)
# IMMICH_LIBRARIES={"User1": "api-key-1...", "User2": "api-key-2..."}

# Processing Configuration
CONFIDENCE_THRESHOLD=0.35
BATCH_SIZE=250  # Maximum assets processed per cycle
MAX_BATCHES_PER_RUN=0  # Maximum batches per scheduled run (0 = unlimited)
INFERENCE_BATCH_SIZE=8  # Images evaluated by ONNX Runtime at once
DOWNLOAD_WORKERS=4  # Concurrent thumbnail downloads per inference chunk
CHARACTER_THRESHOLD=0.9
PROCESSED_TAG_NAME=auto:processed
# Parent for general/sensitive/questionable/explicit hierarchical tags
CONTENT_RATING_TAG_NAME=content-rating
# Optional comma-separated album names, for example: Anime,Hentai
TARGET_ALBUMS=
TAG_CACHE_TTL=300
FAILURE_TIMEOUT=3  # Max retries for failed assets (0 = never retry)
CONFIG_DIR=/config  # Persistent runtime state inside the container

# Logging
LOG_LEVEL=INFO

# Optional: Model Configuration
TAGGING_MODEL=wd14
WD_MODEL_REPO=SmilingWolf/wd-swinv2-tagger-v3
MODEL_CACHE_DIR=/config/models
ONNX_INTRA_OP_THREADS=0  # 0 lets ONNX Runtime decide
UNLOAD_MODEL_AFTER_RUN=false  # If true, unload except when next run is <15m away

# Optional: Performance Tuning
MAX_RETRIES=3
RETRY_DELAY=1.0
REQUEST_TIMEOUT=30.0

# Optional: Scheduling Configuration (for scheduler mode)
ENABLE_SCHEDULER=true
CRON_SCHEDULE=0 2 * * *  # Daily at 2 AM (cron format)
TIMEZONE=UTC
